{
  "name": "prts-live-dossier",
  "private": true,
  "version": "1.0.0",
  "description": "卫戍协议战术终端",
  "author": "PRTS Stronghold",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "prepare:desktop": "node node_modules/electron/install.js",
    "prepare:ocr": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-ocr.ps1",
    "desktop": "npm run prepare:desktop && electron .",
    "package:win": "npm run prepare:desktop && npm run prepare:ocr && npm run lint && npm run build && pwsh -NoProfile -File scripts/build-windows.ps1 -Version 1.0.0",
    "cache:avatars": "node --import tsx scripts/cache-avatars.ts"
  },
  "build": {
    "appId": "com.prts.dossier.live",
    "productName": "PRTS Live Dossier",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "work/windows-ocr/runtime/PRTS-OCR",
        "to": "ocr"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "PRTS-Stronghold-${version}-Windows-x64.exe"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "productName": "PRTS Live Dossier"
}
