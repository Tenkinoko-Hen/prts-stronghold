<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="${package}" android:versionCode="${versionCode}" android:versionName="${versionName}">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <queries>
        <package android:name="com.hypergryph.arknights" />
        <package android:name="com.hypergryph.arknights.bilibili" />
        <package android:name="com.YoStarEN.Arknights" />
        <package android:name="com.YoStarJP.Arknights" />
        <package android:name="com.YoStarKR.Arknights" />
        <package android:name="tw.txwy.and.arknights" />
    </queries>
    <application android:label="@string/app_name" android:icon="${icon}" android:roundIcon="${roundIcon}" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ReportFiles" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="${package}.export" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".CapturePermissionActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="${package}.capture" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".VpnPermissionActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="${package}.vpn" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service android:name=".CovenantScanService" android:exported="false" android:foregroundServiceType="mediaProjection" android:stopWithTask="true" />
        <service android:name=".OverlayService" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started offline tactical guide with a draggable floating ball and collapsible guide panel while playing a game; ends on user request." />
        </service>
        <service android:name=".StrongholdVpnService" android:exported="false" android:permission="android.permission.BIND_VPN_SERVICE" android:foregroundServiceType="specialUse" android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started local loopback packet analyzer for Arknights Stronghold battle statistics; no remote proxy or data modification." />
        </service>
    </application>
</manifest>
